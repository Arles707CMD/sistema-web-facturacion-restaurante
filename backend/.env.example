# ===========================================
# RESTAURANTE BALUARTE - BACKEND (.env.example)
# Copia este archivo como "backend/.env" y ajusta los valores locales.
# NUNCA subas el archivo .env real (con credenciales) a Git/GitHub.
# ===========================================

# Conexión a la base de datos MySQL/MariaDB
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=restaurante_baluarte
DB_PORT=3306

# Puerto del servidor Express
PORT=3000

# TLS/SSL opcional para MySQL gestionado (p. ej. Aiven desde Render).
# false (o ausente) mantiene la conexión local actual (XAMPP/MariaDB).
# true exige DB_CA_CERT_BASE64: certificado CA del proveedor en Base64.
# En producción estos valores se configuran en el panel de Render,
# nunca en este archivo.
DB_SSL=false
DB_CA_CERT_BASE64=

# Seguridad: autenticación JWT, expiración del token y CORS.
# Cambia JWT_SECRET por un secreto largo y único antes de usar en producción.
# TOKEN_EXPIRA: duración de la sesión normal (sin "Recordarme").
# TOKEN_EXPIRA_RECUERDA: duración de la sesión persistente cuando el
# usuario marca "Recordarme" en el login.
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_seguro
TOKEN_EXPIRA=2h
TOKEN_EXPIRA_RECUERDA=30d

# Origen permitido por CORS (frontend en desarrollo con Vite).
# En producción: URL pública real del frontend en Netlify.
CLIENT_ORIGIN=http://localhost:5173

# ===========================================
# RECUPERACIÓN DE CONTRASEÑA (API HTTPS DE BREVO)
# Configura estos valores en el panel de Render (Environment).
# Se usa la API HTTPS oficial de Brevo (POST /v3/smtp/email)
# porque Render gratuito bloquea el SMTP saliente; ya NO se
# usan variables SMTP_*.
# Sin ellas, el flujo funciona pero NO se envían correos reales
# (queda registrado en los logs del servidor).
# ===========================================

# Clave API de Brevo con acceso restringido a emails transaccionales
# (secreto: solo en Render, nunca en este archivo).
BREVO_API_KEY=
# Correo del remitente VERIFICADO en Brevo (Senders & IP).
BREVO_FROM_EMAIL=
# Nombre visible del remitente (opcional).
BREVO_FROM_NAME=Restaurante Baluarte

# URL pública del frontend, usada para construir el enlace del correo
# de recuperación. En producción: https://restaurante-baluarte.netlify.app
APP_URL=http://localhost:5173