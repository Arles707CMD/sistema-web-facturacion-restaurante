{
  "info": {
    "name": "GA7-AA5-EV01 - Restaurante Baluarte (Autenticación)",
    "description": "Casos de prueba del servicio web de autenticación (registro y login). Usa las variables {{baseUrl}}, {{testEmail}} y {{testPassword}} del environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Registro exitoso",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Usuario Prueba\",\n  \"correo\": \"{{testEmail}}\",\n  \"contrasena\": \"{{testPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "register"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"No expone hash ni salt\", function () { var t = JSON.stringify(pm.response.json()); pm.expect(t).to.not.include('contrasena_hash'); pm.expect(t).to.not.include('salt'); });"
            ]
          }
        }
      ]
    },
