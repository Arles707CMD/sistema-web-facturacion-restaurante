              "pm.test('Mensaje correo ya registrado', function () { pm.expect(pm.response.json().mensaje).to.include('registrado'); });",
              "pm.test('No expone hash ni salt', function () { var t = pm.response.text(); pm.expect(t).to.not.include('contrasena_hash'); pm.expect(t).to.not.include('salt'); });"
            ]
          }
        }
      ]
