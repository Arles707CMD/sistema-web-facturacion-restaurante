{
  "info": {
    "name": "GA7-220501096-AA5-EV01 - Restaurante Baluarte (Autenticación)",
    "description": "Colección con los 10 casos de prueba del servicio de autenticación (registro y login) para la evidencia GA7-220501096-AA5-EV01. Usa las variables {{baseUrl}}, {{testEmail}} y {{testPassword}} del environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Registro exitoso",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": "{\"nombre\":\"Usuario Prueba\",\"correo\":\"{{testEmail}}\",\"contrasena\":\"{{testPassword}}\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "register"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
              "pm.test('Devuelve usuario seguro', function () { var u = pm.response.json().usuario; pm.expect(u.rol).to.eql('Ventas'); pm.expect(u.estado).to.eql('Activo'); });",
              "pm.test('No expone contrasena, hash ni salt', function () { var t = pm.response.text(); pm.expect(t).to.not.include('contrasena_hash'); pm.expect(t).to.not.include('salt'); pm.expect(t).to.not.include('password'); pm.expect(pm.response.json().usuario).to.not.have.property('contrasena'); });"
            ]
          }
        }
      ]
    },
    {
